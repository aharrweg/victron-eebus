    {
        "id": "fn_status_check",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "Status Auswerter",
        "func": "let data = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\nlet msg14a = {};\nlet msgPV = {};\n\n// Kontext-Speicher für den letzten gültigen Online-Zeitpunkt\nlet lastConnectedTime = flow.get(\"eebus_last_connected\") || Date.now();\nlet now = Date.now();\n\nif (data.connected === true) {\n    // Verbindung ist da -> Zeitstempel aktualisieren und Normalbetrieb\n    flow.set(\"eebus_last_connected\", now);\n    node.status({fill: \"green\", shape: \"dot\", text: \"Verbunden\"});\n    \n    msg14a.payload = { active: false, power_limit_w: 0 };\n    msgPV.payload = { active: false, power_limit_w: 0 };\n} \nelse if (data.connected === false) {\n    // Prüfen, ob der Ausfall länger als 5 Sekunden her ist (toleriert kurze Wackler)\n    let diffSeconds = (now - lastConnectedTime) / 1000;\n    \n    if (diffSeconds > 5) {\n        node.status({fill: \"red\", shape: \"dot\", text: \"VERBINDUNG GETRENNT (>5s)!\"});\n        \n        // Fail-Safe greift erst nach 5 Sekunden echtem Ausfall\n        msg14a.payload = { active: true, power_limit_w: 4200, failsafe: true };\n        msgPV.payload = { active: false, power_limit_w: 0 };\n    } else {\n        node.status({fill: \"yellow\", shape: \"dot\", text: \"Wackler ignoriert (\" + Math.round(diffSeconds) + \"s)\"});\n        return null; // Ignoriert die Nachricht vorerst, kein Schalten!\n    }\n}\n\nreturn [msg14a, msgPV];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 320,
        "wires": [
            [
                "3a123dce8557e76c"
            ],
            [
                "391e96c55e8d4ae2"
            ]
        ]
    },
    {
        "id": "391e96c55e8d4ae2",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "EEG PV Limit -> Victron ESS",
        "func": "// Daten auslesen (egal ob String oder JSON-Objekt)\nlet data = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.active === true) {\n    let watt = data.power_limit_w;\n    \n    // Status visualisieren (gelb = Einspeisung gedrosselt)\n    node.status({fill: \"yellow\", shape: \"dot\", text: \"PV GEDIMMT: \" + Math.floor(watt) + \" W\"});\n    \n    // Gibt die Watt-Zahl direkt als payload für die Victron-Node aus\n    return { payload: watt };\n    \n} else {\n    // Normalbetrieb (grün = 100% Ertrag)\n    node.status({fill: \"green\", shape: \"dot\", text: \"PV Normalbetrieb (100%)\"});\n    \n    // -1 deaktiviert das ESS Feed-In Limit im Victron D-Bus (volle Einspeisung)\n    return { payload: -1 };\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
        "y": 420,
        "wires": [
            [
                "4626f018695b03f2",
                "eebus_gate_switch"
            ]
        ]
    },
