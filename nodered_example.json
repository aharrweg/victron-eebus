    {
        "id": "3a123dce8557e76c",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "§14a Limit -> Victron (Ampere)",
        "func": "// Daten auslesen (egal ob String oder JSON-Objekt)\nlet data = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.active === true) {\n    let watt = data.power_limit_w || 4200;\n    \n    // Status visualisieren (rot = Dimmung aktiv)\n    node.status({fill: \"red\", shape: \"dot\", text: \"GEDIMMT: \" + Math.floor(watt) + \" W\"});\n    \n    // Beispiel 1: Dreiphasiger Bezugsstrom (4200 W / (3 * 230 V) ≈ 6.08 A)\n    let currentLimitAmps = Math.floor(watt / (3 * 230));\n\n    return [\n        { topic: \"victron/limit/active\", payload: true, watt: watt },\n        { topic: \"victron/ac_input_limit\", payload: currentLimitAmps }\n    ];\n} else {\n    // Normalbetrieb (grün = keine Dimmung)\n    node.status({fill: \"green\", shape: \"dot\", text: \"Normalbetrieb (Ungedimmt)\"});\n    \n    return [\n        { topic: \"victron/limit/active\", payload: false },\n        { topic: \"victron/ac_input_limit\", payload: 16 } // Standard z.B. 16A / Hausanschluss\n    ];\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 420,
        "wires": [
            [
                "1be141934c5f5592"
            ]
        ]
    },
    {
        "id": "fn_pv_limit",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "EEG PV Limit -> Victron ESS",
        "func": "let data = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\nif (data.active === true) {\n    let watt = data.power_limit_w;\n    \n    // Status visualisieren (gelb = Einspeisung gedrosselt)\n    node.status({fill: \"yellow\", shape: \"dot\", text: \"PV GEDIMMT: \" + Math.floor(watt) + \" W\"});\n    \n    // Victron erwartet die max. Einspeisung in Watt\n    return { payload: watt };\n} else {\n    // Normalbetrieb (grün = 100%)\n    node.status({fill: \"green\", shape: \"dot\", text: \"PV Normalbetrieb (100%)\"});\n    \n    // -1 oder ein sehr hoher Wert deaktiviert das ESS Feed-In Limit im Victron D-Bus\n    return { payload: -1 };\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 500,
        "wires": [
            [
                "4626f018695b03f2"
            ]
        ]
    },
