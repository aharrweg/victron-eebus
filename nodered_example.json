    {
        "id": "fn_heartbeat",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "Heartbeat Parse",
        "func": "node.status({fill:\"green\", shape:\"dot\", text: \"Aktiv: \" + msg.payload.cerbo_ski.substring(0,8) + \"...\"});\nmsg.payload = {\n    status: msg.payload.status,\n    ski: msg.payload.cerbo_ski,\n    letzter_kontakt: msg.payload.timestamp\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 610,
        "y": 100,
        "wires": [
            [
                "debug_heartbeat"
            ]
        ]
    },
    {
        "id": "fn_discovery",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "Discovery Parse",
        "func": "node.status({fill:\"blue\", shape:\"ring\", text: \"Gefunden: \" + msg.payload.count + \" Geräte\"});\nreturn msg;",
        "outputs": 1,
