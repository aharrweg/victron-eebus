    {
        "id": "3a123dce8557e76c",
        "type": "function",
        "z": "eebus_sub_flow",
        "name": "§14a Steuerung",
        "func": "let data = typeof msg.payload === \"string\" ? JSON.parse(msg.payload) : msg.payload;\n\n// 1. Status und echte Leistung robust auslesen\nlet wpActive = flow.get(\"wp_active\") !== undefined ? flow.get(\"wp_active\") : true;\nlet wpPower  = flow.get(\"wp_power\") !== undefined ? flow.get(\"wp_power\") : 0;\n\nlet wbActive = flow.get(\"wb_active\") !== undefined ? flow.get(\"wb_active\") : false;\nlet wbPower  = flow.get(\"wb_power\") !== undefined ? flow.get(\"wb_power\") : 0;\n\nlet msgWP = {};\nlet msgWB = {};\nlet msgStatus = {}; \n\nlet isLimited = (data && data.active === true);\n\nif (isLimited) {\n    let totalBudget = data.power_limit_w || 4200;\n    \n    msgStatus = { payload: true, limit_w: totalBudget };\n    \n    // Fall 1: Wärmepumpe zieht aktiv Leistung -> Sie bekommt Vorrang\n    if (wpActive && wpPower > 0) {\n        let dynamicBudgetWB = Math.max(0, totalBudget - wpPower);\n        \n        node.status({fill: \"red\", shape: \"dot\", text: \"§14a aktiv: WP läuft (\" + wpPower + \"W) -> WB Restbudget: \" + dynamicBudgetWB + \"W\"});\n        \n        msgWP = { payload: totalBudget, restricted: true, device: \"heatpump\" };\n        msgWB = { payload: (wbActive && wbPower > 0) ? dynamicBudgetWB : 0, restricted: true, device: \"wallbox\" };\n    } \n    // Fall 2: Wärmepumpe ist aus oder zieht 0W\n    else {\n        node.status({fill: \"orange\", shape: \"dot\", text: \"§14a aktiv: WP aus -> WB darf mit vollem Budget laden\"});\n        \n        msgWP = { payload: 0, restricted: true, device: \"heatpump\" };\n        \n        // KORREKTUR: Wenn die Wallbox lädt, kriegt sie das volle §14a-Budget (4200W) statt 0W!\n        let allocatedWB = (wbActive && wbPower > 0) ? totalBudget : 0;\n        msgWB = { payload: allocatedWB, restricted: true, device: \"wallbox\" };\n    }\n} else {\n    // Normalbetrieb: Keine §14a-Dimmung aktiv -> Echte Leistungswerte durchreichen!\n    node.status({fill: \"green\", shape: \"dot\", text: \"Normalbetrieb: SteuVE uneingeschränkt (Durchleitung)\"});\n    \n    msgStatus = { payload: false, limit_w: 0 };\n    \n    msgWP = { payload: wpPower, restricted: false, device: \"heatpump\" };\n    msgWB = { payload: wbPower, restricted: false, device: \"wallbox\" };\n}\n\nreturn [msgWP, msgWB, msgStatus];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
