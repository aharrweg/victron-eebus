                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "eebus/grid/limit",
        "payload": "{   \"active\": true,   \"power_limit_w\": 4200 }",
